{
  "name": "timesfps",
  "version": "1.0.0-alpha.1",
  "description": "Truly fluid spring motion on WAAPI, no `linear()` approximations. Yoyo and mirror repeats, and repeat delays. All natively played.",
  "keywords": [
    "animation",
    "web-animations-api",
    "waapi",
    "spring",
    "spring-animation",
    "spring-physics",
    "native-animation",
    "motion",
    "motion-design",
    "animation-sequence",
    "timeline",
    "keyframes",
    "easing"
  ],
  "license": "MIT",
  "author": "Naved <navedm1424@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "prebuild": "rm -rf dist/",
    "build": "tsc",
    "postbuild": "find dist \\( -name \"*.types.js\" -o -name \"*.runtime.d.ts\" \\) -delete",
    "prepack": "rm -f ${npm_package_name}-${npm_package_version}.tgz",
    "test": "vitest run --typecheck --typecheck.tsconfig tests/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navedm1424/times-fps.git"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
